# Production shared storage. Leave blank for local file-backed Director Mode.
DATABASE_URL=
# Use "disable" only for a local PostgreSQL server without TLS.
DATABASE_SSL=require
# Random secret for the scheduled /api/cron/cleanup endpoint.
CRON_SECRET=

# Nexconn Chat — server credentials (never expose the secret to the browser)
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_BASE_URL=https://api.sg-light-api.com
NEXT_PUBLIC_NEXCONN_APP_KEY=

# Optional OpenAI-compatible model for unscripted contestant dialogue.
# Without these values the built-in deterministic Director keeps the game playable.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
